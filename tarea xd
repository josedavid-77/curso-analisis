def suma_mayores_o_iguales_rec(valor_limite, lista):
    if not lista:
        return 0
    if lista[0] >= valor_limite:
        return lista[0] + suma_mayores_o_iguales_rec(valor_limite, lista[1:])
    return suma_mayores_o_iguales_rec(valor_limite, lista[1:])

if __name__ == "__main__":
    limite = 5
    numeros = [2, 7, 5, 3, 8, 1]
    resultado = suma_mayores_o_iguales_rec(limite, numeros)
    print(f"La suma de los valores >= {limite} es: {resultado}")

